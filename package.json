{
  "name": "file-inspector-finder",
  "type": "module",
  "private": false,
  "version": "1.1.0",
  "description": "Paseo plugin to reveal images and files in Finder/Explorer, preview in macOS Preview or Code Editors, inspect image dimensions & metadata, and browse workspace media from tabs, headers, composer pills, right-click/Option+Click, ⌘K, and /reveal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vecyang1/paseo-plugin-file-inspector-finder.git"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "finder",
    "reveal-in-finder",
    "image-inspector",
    "file-explorer"
  ],
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "README.md",
    "LICENSE",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/register-ts.mjs --test test/plugin.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
